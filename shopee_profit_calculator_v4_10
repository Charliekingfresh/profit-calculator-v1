      });
      $('export-csv').addEventListener('click', () => {
        const headers = ['儲存時間','商品或備註','蝦皮售價','平台抽成(%)','進貨成本','雜費','品類平台抽成(%)','金流服務費(%)','免運服務費(%)','扣除抽成後利潤','扣除抽成後利潤率(%)','未扣抽成利潤','未扣抽成利潤率(%)','扣後期望利潤率(%)','未扣期望利潤率(%)','扣後反推區產品售價','未扣反推區產品售價','預估稅率(%)','每件預估稅金'];
        const lines = [headers.map(csvCell).join(',')];
        records.forEach(r => {
          const m = calculate(r.price,r.fee,r.cost,r.misc,r.tax);
          const displayPrice = (side,custom) => custom ? r[`target${side}Price`] : requiredPriceForRecord(r, side);
          lines.push([dateLabel(r.savedAt),r.name,r.price,r.fee,r.cost,r.misc,r.feeParts?.category??'',r.feeParts?.payment??'',r.feeParts?.shipping??'',m.after,m.afterRate.toFixed(2),m.before,m.beforeRate.toFixed(2),r.targetAfter,r.targetBefore,
            displayPrice('After',r.targetAfterCustom),displayPrice('Before',r.targetBeforeCustom),r.tax,roundCents(r.price*r.tax/100)].map((value,index) => csvCell(value ?? '無法達成',index === 1)).join(','));
        });
        fileDownload(lines.join('\r\n'),'text/csv;charset=utf-8',`蝦皮試算紀錄_${dateStamp()}.csv`);
        alertStatus(`已匯出 ${records.length} 筆紀錄的 CSV 表格。`);
      });
      $('import-button').addEventListener('click', () => $('import-file').click());
      $('import-file').addEventListener('change', async event => {
        const file = event.target.files?.[0];
        event.target.value = '';
        if (!file) return;
        if (file.size > 2 * 1024 * 1024) { alertStatus('檔案過大，請選擇小於 2MB 的 JSON 備份。',true); return; }
        try {
          const parsed = JSON.parse((await file.text()).replace(/^\uFEFF/,''));
          if (!parsed || parsed.format !== 'shopee-profit-records' || ![1,2].includes(parsed.version) || !Array.isArray(parsed.records)) throw new Error('不支援此備份格式');
          if (parsed.records.length > 500) throw new Error('備份筆數超過 500 筆限制');
          const imported = parsed.records.map(normalizeRecord);
          if (imported.some(r => r === null)) throw new Error('備份包含不符合格式的紀錄');
          const existingIds = new Set(records.map(r => r.id));
          const newlyAdded = imported.filter(r => !existingIds.has(r.id));
          if (records.length + newlyAdded.length > 500) throw new Error('合併後超過 500 筆，請先匯出並整理舊紀錄');
          records = [...newlyAdded,...records].sort((a,b) => Date.parse(b.savedAt) - Date.parse(a.savedAt));
          const saved = persistRecords();
          renderRecords();
          alertStatus(saved ? `匯入成功，新增 ${newlyAdded.length} 筆紀錄（重複紀錄已略過）。` : '匯入成功，但本機儲存不可用；請立即再匯出備份。',!saved);
        } catch (error) { alertStatus(`匯入失敗：${error.message}`,true); }
      });
      $('clear-records').addEventListener('click', () => {
        if (!records.length) { alertStatus('目前沒有紀錄可清空。'); return; }
        if (!confirm(`確定清空所有 ${records.length} 筆紀錄嗎？這個操作無法復原，建議先匯出 JSON 備份。`)) return;
        records = [];
        const saved = persistRecords();
        renderRecords();
        alertStatus(saved ? '已清空所有紀錄。' : '畫面紀錄已清空，但瀏覽器儲存不可用。',!saved);
      });
      bindRoas();
    })();
  </script>
</body>
</html>
