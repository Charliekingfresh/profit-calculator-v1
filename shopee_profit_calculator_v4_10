<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>蝦皮利潤計算機 V4.9.1｜稅金與 ROAS 試算</title>
  <style>
    :root {
      --page: #f6f7fb;
      --surface: #fff;
      --ink: #111b32;
      --muted: #8290a6;
      --line: #dfe5ee;
      --accent: #ffbf00;
      --accent-dark: #966500;
      --violet: #6558ff;
      --green: #008d6a;
      --red: #d64d5b;
      --shadow: 0 12px 34px rgba(31,42,74,.045);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; background: var(--page); color: var(--ink);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
      font-size: 15px; line-height: 1.6;
    }
    button, input { font: inherit; }
    button { cursor: pointer; }
    .layout { max-width: 1200px; margin: 0 auto; padding: 34px 28px 76px; }
    .top-header { text-align: center; margin-bottom: 33px; }
    .eyebrow {
      display: inline-flex; align-items: center; border: 1px solid #ffe29a;
      background: #fff7de; color: #936500; border-radius: 999px;
      font-size: 12px; font-weight: 800; padding: 5px 15px; letter-spacing: .03em;
    }
    h1 { margin: 13px 0 3px; font-size: clamp(31px,4vw,43px); line-height: 1.35; letter-spacing: -.045em; font-weight: 850; }
    h1 span { color: #e6a900; }
    .lead { color: #7f8da5; margin: 6px 0 0; font-size: 14px; }
    .inputs { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 16px; align-items: start; }
    .extra-hint { margin: 12px 0 0; color: #96a2b4; font-size: 12px; }
    .card {
      background: var(--surface); border: 1px solid var(--line); border-radius: 17px;
      box-shadow: var(--shadow); min-width: 0;
    }
    .input-card { padding: 25px 23px 27px; min-height: 190px; }
    .card-head { display: flex; align-items: center; gap: 11px; margin-bottom: 25px; }
    .step { display: inline-flex; justify-content: center; align-items: center; flex: none; width: 26px; height: 26px; border-radius: 50%; background: #fff1bc; color: #8a6300; font-weight: 800; font-size: 14px; }
    h2 { margin: 0; font-size: 17px; font-weight: 800; letter-spacing: -.025em; }
    .field-row { display: flex; gap: 10px; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .field-row label { font-weight: 700; font-size: 14px; }
    .number-shell { position: relative; width: 145px; flex: 0 0 145px; }
    input[inputmode="decimal"] {
      width: 100%; height: 39px; padding: 7px 41px 7px 11px;
      background: #fff; border: 1px solid #d9e0eb; border-radius: 9px;
      color: #0a1630; font-family: inherit; font-size: 15px; font-weight: 800; line-height: 1.3;
      text-align: right; font-variant-numeric: tabular-nums; outline: none;
      transition: box-shadow .2s,border-color .2s; appearance: textfield; -moz-appearance: textfield;
    }

    input[inputmode="decimal"]:focus, input[type="text"]:focus { border-color: #f4b900; box-shadow: 0 0 0 3px rgba(255,191,0,.17); outline: none; }
    .suffix { position: absolute; top: 50%; right: 11px; transform: translateY(-50%); font-size: 12px; color: #98a5b9; pointer-events: none; white-space: nowrap; }
    input[type="range"] {
      --progress: 0%; appearance: none; -webkit-appearance: none; width: 100%; height: 6px;
      margin: 0; display: block; cursor: pointer; border-radius: 99px;
      background: linear-gradient(to right,var(--accent) 0 var(--progress),#e7eaf2 var(--progress) 100%);
    }
    input[type="range"]::-webkit-slider-thumb {
      appearance: none; -webkit-appearance: none; width: 17px; height: 17px;
      background: var(--accent); border: 2px solid white; border-radius: 50%; box-shadow: 0 0 0 1px #eca900;
    }
    input[type="range"]::-moz-range-thumb {
      width: 13px; height: 13px; background: var(--accent); border: 2px solid white; border-radius: 50%; box-shadow: 0 0 0 1px #eca900;
    }
    input[type="range"]:focus-visible, button:focus-visible { outline: 3px solid rgba(255,191,0,.5); outline-offset: 4px; }
    .range-hints { display: flex; justify-content: space-between; margin-top: 11px; color: #a2aec0; font-size: 11px; font-variant-numeric: tabular-nums; }

    /* 抽成細項展開區 */
    .fee-toggle { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px;
      margin-top: 16px; padding: 9px 11px; border: 1px solid #e6dfc4; border-radius: 10px;
      color: #816218; background: #fffbf0; font-size: 12px; font-weight: 800; }
    .fee-toggle:hover { background: #fff3cc; }
    .fee-toggle .arrow { font-size: 13px; transition: transform .2s; }
    .fee-toggle[aria-expanded="true"] .arrow { transform: rotate(180deg); }
    .fee-details { margin-top: 13px; border-top: 1px solid #edf0f5; padding-top: 14px; }
    .fee-details[hidden] { display: none; }
    .fee-detail-row { display: flex; align-items: center; justify-content: space-between; gap: 7px; margin: 9px 0; }
    .fee-detail-row label { font-size: 12px; font-weight: 700; flex: 1 1 auto; }
    .fee-detail-row .number-shell { flex: 0 0 100px; width: 100px; }
    .fee-detail-row input[inputmode="decimal"] { height: 36px; font-size: 13px; padding-right: 28px; }
    .fee-detail-row .suffix { right: 9px; }
    .fee-detail-hint { margin: 4px 0 10px; font-size: 11px; color: #8b98ae; }
    .fee-detail-status { margin-top: 11px; padding: 9px 10px; background: #f7f8fd; border-radius: 9px;
      color: #667792; font-size: 11px; line-height: 1.65; }
    .fee-detail-status.error { color: #ba394a; background: #fff2f3; }
    .fee-auto-indicator { color: #8c6611; font-size: 10px; font-weight: 700; white-space: nowrap; }
    .fee-clear { padding: 4px 0; margin-top: 8px; border: 0; color: #6f7e92; background: transparent;
      font-size: 11px; text-decoration: underline; }
    .results { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; margin-top: 17px; }
    .result-card { padding: 23px 25px 25px; }
    .result-heading { color: #667792; font-weight: 800; font-size: 14px; margin-bottom: 14px; }
    .result-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .metric-label { font-size: 13px; color: #8998ae; margin: 0 0 4px; }
    .metric-value { font-size: clamp(21px,2.6vw,33px); font-weight: 850; line-height: 1.2; letter-spacing: -.045em; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
    .metric-value.purple { color: var(--violet); }
    .metric-value.green { color: var(--green); }
    .metric-value.negative { color: var(--red); }
    .result-note { margin: 18px 0 0; color: #a0aabb; font-size: 12px; border-top: 1px solid #edf0f5; padding-top: 12px; }
    .footnote { text-align: center; color: #8a97ad; font-size: 12px; margin: 23px auto 0; max-width: 900px; }
    .section-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 40px 1px 16px; }
    .section-header h2 { font-size: 21px; }
    .section-subtitle { margin: 3px 0 0; color: #8d9bb0; font-size: 13px; }
    .target-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; }
    .target-card { padding: 24px 25px 20px; }
    .target-card .card-head { margin-bottom: 16px; }
    .pill { display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; font-size: 11px; padding: 3px 8px; font-weight: 800; }
    .pill.violet { background: #eeedff; color: #6155e6; }
    .pill.green { background: #e2f8ee; color: #00866a; }
    .target-price-box { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 20px; margin-bottom: 16px; padding: 16px 17px; background: #f8f9fd; border: 1px solid #eef0f6; border-radius: 13px; }
    .target-price-caption { font-size: 12px; color: #7c8ba1; font-weight: 700; }
    .target-price-value { font-size: clamp(24px,2.6vw,31px); font-weight: 850; line-height: 1.25; letter-spacing: -.035em; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .target-price-value.violet { color: var(--violet); }
    .target-price-value.green { color: var(--green); }
    .target-price-value.unreachable { color: var(--red); font-size: 20px; }
    .target-price-control { display: inline-flex; align-items: center; justify-content: flex-end; gap: 5px; flex: 0 1 190px; min-width: 0; }
    .target-price-currency { color: var(--violet); font-size: clamp(21px,2.6vw,30px); font-weight: 850; white-space: nowrap; }
    .target-price-control.green .target-price-currency { color: var(--green); }
    input[inputmode="decimal"].target-price-number {
      width: 100%; min-width: 0; height: 43px; padding: 5px 9px; background: transparent;
      border-color: transparent; border-bottom: 1px dashed #d6ddea; border-radius: 4px;
      color: var(--violet); font-size: clamp(22px,2.6vw,30px); font-weight: 850;
      text-align: right; letter-spacing: -.035em;
    }
    .target-price-control.green input[inputmode="decimal"].target-price-number { color: var(--green); }
    input[inputmode="decimal"].target-price-number:focus { background: #fff; border: 1px solid #f4b900; }
    .target-price-box { margin-bottom: 17px; }
    .target-price-box .target-price-caption { max-width: 210px; }
    .target-price-hints { margin: 8px 0 0; }
    .target-price-feedback { margin: 12px 0 0; font-size: 12px; color: #75849b; line-height: 1.65; }
    .target-price-feedback b { color: var(--green); }
    .target-price-feedback .not-met, .target-price-feedback .unreachable { color: var(--red); }
    .target-price-feedback .advisory { color: #8c7892; }
    .table-header { margin-top: 18px; padding-top: 16px; border-top: 1px solid #eef0f6; color: #8996ac; font-size: 13px; font-weight: 800; }
    .quick-table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 14px; }
    .quick-table td { padding: 7px 3px; border-bottom: 1px solid #f0f2f7; }
    .quick-table tr:last-child td { border-bottom: none; }
    .quick-table td:nth-child(2) { text-align: right; font-weight: 800; font-variant-numeric: tabular-nums; }
    .quick-table td:last-child { text-align: right; font-weight: 750; font-variant-numeric: tabular-nums; color: #78869b; white-space: nowrap; width: 88px; }
    .quick-table td:first-child { width: 22%; }
    .quick-table td:nth-child(2) { padding-right: 16px; }
    .quick-table thead th { color: #98a3b3; font-size: 11px; font-weight: 700; padding: 6px 3px 7px; border-bottom: 1px solid #eef0f6; }
    .quick-table thead th:first-child { text-align: left; }
    .quick-table thead th:nth-child(2) { text-align: right; padding-right: 16px; }
    .quick-table thead th:last-child { text-align: right; white-space: nowrap; width: 88px; }
    .quick-table .active-row td:last-child { color: #8a753e; }
    @media (max-width: 420px) { .quick-table td:last-child, .quick-table thead th:last-child { width: 71px; } .quick-table td:nth-child(2), .quick-table thead th:nth-child(2) { padding-right: 7px; } }
    .quick-table td:first-child { color: #72829a; }
    .quick-table .active-row td { color: var(--accent-dark); background: #fffaf0; }
    .quick-table .invalid-price { color: #c97376; font-weight: 700; font-size: 12px; }
    .target-help { font-size: 12px; line-height: 1.7; color: #95a1b5; margin: 14px 0 0; }
    .history-section { margin-top: 41px; }
    .history-section .section-header { margin-top: 0; }
    .history-card { padding: 23px 25px 25px; }
    .history-form { display: flex; align-items: end; flex-wrap: wrap; gap: 11px; margin-bottom: 18px; }
    .name-group { display: grid; gap: 6px; flex: 1 1 250px; }
    .name-group label { font-weight: 700; font-size: 13px; }
    #record-name { height: 41px; width: 100%; border: 1px solid #d9e0eb; border-radius: 9px; padding: 9px 12px; font-size: 14px; color: var(--ink); background: #fff; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; white-space: nowrap; min-height: 40px; padding: 8px 15px; border: 1px solid #d9e0eb; background: #fff; color: #53657f; border-radius: 9px; font-size: 13px; font-weight: 800; transition: background .15s,border-color .15s; }
    .btn:hover { background: #f7f8fc; border-color: #bfc8d5; }
    .btn-primary { color: #5f4500; background: #ffd445; border-color: #f6c52b; }
    .btn-primary:hover { background: #ffca19; border-color: #f4bc11; }
    .btn-danger { color: #bd4551; }
    .btn-danger:hover { background: #fff2f3; border-color: #eaaab1; }
    .btn-small { padding: 4px 9px; font-size: 12px; min-height: 29px; }
    .history-actions { display: flex; gap: 9px; flex-wrap: wrap; padding-top: 16px; border-top: 1px solid #edf0f5; }
    .history-scroller { overflow-x: auto; border-radius: 11px; border: 1px solid #edf0f5; }
    .history-table { width: 100%; border-collapse: collapse; min-width: 870px; font-variant-numeric: tabular-nums; }
    .history-table th { text-align: left; font-size: 12px; color: #8493aa; font-weight: 700; background: #fafbfd; padding: 12px 10px; white-space: nowrap; }
    .history-table td { border-top: 1px solid #edf0f5; padding: 12px 10px; font-size: 13px; color: #39475e; white-space: nowrap; }
    .history-table td.record-title { white-space: normal; max-width: 230px; font-weight: 750; overflow-wrap: anywhere; }
    .history-table .record-buttons { display: flex; gap: 6px; }
    .history-table .negative { color: var(--red); }
    /* 歷史紀錄：扣除抽成後在上，尚未扣除抽成在下。 */
    .history-profit-stack { display: flex; flex-direction: column; gap: 6px; min-width: 110px; }
    .history-profit-after { font-weight: 700; color: #39475e; }
    .history-profit-before { display: flex; flex-direction: column; gap: 1px; padding-top: 6px; border-top: 1px dashed #e4e9f0; }
    .history-profit-before-label { color: #8998ae; font-size: 10px; line-height: 1.4; font-weight: 500; }
    .history-profit-before-value { font-weight: 800; color: var(--green); }
    .history-profit-after.negative, .history-profit-before-value.negative { color: var(--red); }

    .empty-records { padding: 30px 18px; text-align: center; color: #8b98aa; font-size: 14px; }
    .storage-message { font-size: 12px; color: #8a97ad; margin: 14px 0 0; }
    .status { color: #008d6a; font-size: 13px; min-height: 20px; margin-top: 8px; }
    .status.error { color: var(--red); }
    .footer { text-align: center; color: #a0aaba; font-size: 12px; margin-top: 26px; }
    .hidden-file { display: none; }
    @media (min-width: 1041px) {
      .inputs .input-card { padding-inline: 16px; }
      .inputs .number-shell { flex: 0 1 53%; min-width: 0; }
      .inputs .fee-detail-row .number-shell { flex: 0 1 76px; }
    }
    @media (max-width: 1040px) { .inputs { grid-template-columns: repeat(2,minmax(0,1fr)); } }
    @media (max-width: 650px) { .inputs { grid-template-columns: 1fr; } .input-card { min-height: auto; } .input-card .card-head { margin-bottom: 20px; } }
    @media (max-width: 720px) { .target-grid { grid-template-columns: 1fr; } }
    @media (max-width: 580px) {
      .layout { padding: 29px 16px 46px; }
      .top-header { margin-bottom: 25px; }
      .results { grid-template-columns: 1fr; }
      .input-card { padding: 20px; }
      .result-card { padding: 20px; }
      .target-card { padding: 20px; }
      .history-card { padding: 20px 16px; }
      .metric-value { font-size: 28px; }
      .number-shell { width: 130px; flex-basis: 130px; }
      .section-header h2 { font-size: 20px; }
      .target-price-value { font-size: 29px; }
      .target-price-box { flex-wrap: wrap; }
      .target-price-control { flex: 1 1 145px; }
      .history-form .btn-primary { width: 100%; }
      .history-actions .btn { flex: 1 1 auto; }
    }

    /* ROAS 廣告試算：延續原版卡片與滑桿風格 */
    .roas-section { margin-top: 18px; }
    .roas-toggle { width:100%; display:flex; justify-content:space-between; align-items:center; gap:12px; padding:19px 24px; border:1px solid var(--line); border-radius:17px; background:#fff; color:var(--ink); box-shadow:var(--shadow); font-size:17px; font-weight:800; text-align:left; }
    .roas-toggle:hover { background:#fffaf0; }
    .roas-toggle .arrow { transition:transform .2s; color:var(--accent-dark); }
    .roas-toggle[aria-expanded="true"] .arrow { transform:rotate(180deg); }
    .roas-content { padding-top:16px; }
    .roas-content[hidden] { display:none; }
    .roas-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; align-items:stretch; }
    .roas-grid > .roas-overview { grid-column:1 / -1; }
    .roas-card { padding:23px 25px; }
    .roas-card h2 { margin-bottom:16px; }
    .roas-stats { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
    .roas-stat { padding:13px 15px; background:#f8f9fd; border-radius:12px; min-width:0; }
    .roas-stat .metric-label { margin-bottom:5px; }
    .roas-field-hint { margin:8px 0 0; font-size:11px; color:#8b98ae; }
    .roas-stat .metric-value { font-size:clamp(22px,2.6vw,30px); }
    .roas-note { margin:14px 0 0; color:#8a97ad; font-size:12px; line-height:1.7; }
    .roas-field { margin-bottom:20px; }
    .roas-field:last-child { margin-bottom:0; }
    .roas-field .field-row { margin-bottom:12px; }
    .roas-field .number-shell { width:145px; flex-basis:145px; }
    .roas-revenue-stat .roas-field { margin:0; }
    .roas-revenue-stat .field-row { flex-wrap:wrap; gap:8px; }
    .roas-revenue-stat .field-row label { font-size:12px; color:#667792; }
    .roas-revenue-stat .number-shell { width:130px; flex-basis:130px; }
    .roas-threshold { margin:12px 0 0; font-size:12px; color:#72829a; line-height:1.6; }
    .roas-threshold strong { color:var(--violet); }
    .roas-status { margin-top:14px; padding:11px 13px; border-radius:10px; background:#fff8e4; color:#806117; font-size:13px; }
    .roas-status.negative { background:#fff1f3; color:#b93c4b; }
    @media (max-width:580px) {
      input[inputmode="decimal"]:not(.target-price-number), #record-name { font-size:16px; }
      .roas-revenue-stat .number-shell { max-width:100%; min-width:0; }
    }
    @media (max-width:720px) { .roas-grid { grid-template-columns:1fr; } .roas-grid > .roas-overview { grid-column:auto; } }
    @media (max-width:580px) { .roas-toggle { padding:17px 20px; } .roas-card { padding:20px; } .roas-stats { gap:10px; } .roas-stat { padding:12px; } .roas-stat .metric-value { font-size:23px; } }
  </style>
</head>
<body>
  <main class="layout">
    <header class="top-header">
      <span class="eyebrow">互動式利潤試算室 · V4.9.1</span>
      <h1>蝦皮<span>利潤計算機</span></h1>
      <p class="lead">自由輸入或拖曳數值，計算利潤、反推目標售價，並儲存過往試算。</p>
    </header>

    <section class="inputs" aria-label="計算參數">
      <article class="card input-card">
        <div class="card-head"><span class="step">1</span><h2>蝦皮售價</h2></div>
        <div class="field-row"><label for="price-number">商品售價</label><div class="number-shell"><input id="price-number" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" value="399"><span class="suffix">元</span></div></div>
        <input id="price-range" type="range" min="1" max="9999" step="0.01" value="399" aria-label="調整蝦皮售價">
        <div class="range-hints"><span>1 元</span><span>9,999 元</span></div>
      </article>

      <article class="card input-card">
        <div class="card-head"><span class="step">2</span><h2>平台抽成</h2></div>
        <div class="field-row"><label for="fee-number">抽成比例</label><div class="number-shell"><input id="fee-number" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" value="14.5"><span class="suffix">%</span></div></div>
        <input id="fee-range" type="range" min="1" max="100" step="0.01" value="14.5" aria-label="調整平台抽成比例">
        <div class="range-hints"><span>1%</span><span>100%</span></div>
        <button type="button" id="fee-toggle" class="fee-toggle" aria-controls="fee-details" aria-expanded="false">
          <span>＋ 展開抽成細項</span><span class="arrow" aria-hidden="true">⌄</span>
        </button>
        <div id="fee-details" class="fee-details" hidden>
          <p class="fee-detail-hint">可填 0～100%，可輸入至小數點後兩位；留空代表尚未設定。</p>
          <div class="fee-detail-row">
            <label for="fee-category-number">品類平台抽成 <span id="fee-category-auto" class="fee-auto-indicator" hidden>（自動）</span></label>
            <div class="number-shell"><input id="fee-category-number" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder="未填"><span class="suffix">%</span></div>
          </div>
          <div class="fee-detail-row">
            <label for="fee-payment-number">金流服務費 <span id="fee-payment-auto" class="fee-auto-indicator" hidden>（自動）</span></label>
            <div class="number-shell"><input id="fee-payment-number" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder="未填"><span class="suffix">%</span></div>
          </div>
          <div class="fee-detail-row">
