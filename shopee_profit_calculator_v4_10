  <script>
    (() => {
      'use strict';
      const specs = {
        price: { min: 1, max: 9999 },
        fee: { min: 1, max: 100 },
        tax: { min: 0, max: 100 },
        cost: { min: 1, max: 9999 },
        misc: { min: 0, max: 999 },
        'target-after': { min: 10, max: 99 },
        'target-before': { min: 10, max: 99 },
        'target-after-price': { min: 1, max: 9999 },
        'target-before-price': { min: 1, max: 9999 }
      };
      const state = {
        price: 399, fee: 14.5, tax: 0, cost: 173, misc: 0,
        'target-after': 40, 'target-before': 50,
        'target-after-price': 381, 'target-before-price': 346,
        'target-after-custom': false, 'target-before-custom': false
      };
      // feeParts 中的 null = 尚未填寫，數字 0 = 已填 0%。
      const feeKeys = ['category','payment','shipping'];
      let feeParts = { category:null, payment:null, shipping:null };
      let feeAutoPart = null;
      let feeExpanded = false;
      const LEGACY_STORAGE_KEY = 'shopee-profit-calculator-records-v1';
      const STORAGE_KEY = 'shopee-profit-calculator-records-v2';
      const moneyFormat = new Intl.NumberFormat('zh-TW', { maximumFractionDigits: 2 });
      const integerFormat = new Intl.NumberFormat('zh-TW', { maximumFractionDigits: 0 });
      const money = value => `NT$ ${moneyFormat.format(value)}`;
      const wholeMoney = value => `NT$ ${integerFormat.format(value)}`;
      const percent = value => `${value.toFixed(2)}%`;
      const roundCents = value => Math.round((value + 1e-9) * 100) / 100;
      const $ = id => document.getElementById(id);
      let records = [];
      let storageEnabled = true;

      function parseDecimal(raw) {
        if (typeof raw === 'number') return Number.isFinite(raw) ? raw : null;
        if (typeof raw !== 'string') return null;
        const text = raw.trim().normalize('NFKC').replace(',', '.');
        if (!/^-?(?:\d+(?:\.\d*)?|\.\d+)$/.test(text)) return null;
        const value = Number(text);
        return Number.isFinite(value) ? value : null;
      }
      function normalize(key, raw) {
        const value = parseDecimal(raw);
        if (value === null) return null;
        const {min, max} = specs[key];
        return roundCents(Math.max(min, Math.min(max, value)));
      }
      function setSlider(key) {
        const el = $(`${key}-range`);
        const { min, max } = specs[key];
        el.value = String(state[key]);
        el.style.setProperty('--progress', `${Math.max(0,Math.min(100,((state[key] - min) / (max - min)) * 100))}%`);
      }
      // 數字輸入只在離開欄位時整理顯示，避免輸入 0.5 時「0.」被立即改成「0」。
      function bindControl(key) {
        const number = $(`${key}-number`);
        const range = $(`${key}-range`);
        const isTargetPrice = key.endsWith('-price') && key.startsWith('target-');
        const isTargetRate = key === 'target-after' || key === 'target-before';
        const onValue = (raw, fromRange = false) => {
          const next = normalize(key, raw);
          if (next === null) return;
          state[key] = next;
          if (key === 'fee') handleOuterFeeChange();
          if (isTargetRate) {
            const side = key.split('-')[1];
            state[`target-${side}-custom`] = false;
          }
          if (isTargetPrice) {
            const side = key.split('-')[1];
            state[`target-${side}-custom`] = true;
          }
          // range 的操作才立即回填文字；鍵盤打字時保留原本的小數輸入狀態。
          if (fromRange) number.value = String(state[key]);
          setSlider(key);
          recalculate();
        };
        range.addEventListener('input', () => onValue(range.value, true));
        number.addEventListener('input', () => {
          if (number.value.trim() === '') return;
          onValue(number.value, false);
        });
        number.addEventListener('blur', () => {
          // 若正在輸入 0. 或尚未完成輸入，就恢復最後有效值。
          number.value = String(state[key]);
          if (isTargetPrice) updateTarget(key.split('-')[1]);
        });
        setSlider(key);
      }

      function showFeeParts() {
        feeKeys.forEach(part => {
          const input = $(`fee-${part}-number`);
          if (document.activeElement !== input) input.value = feeParts[part] === null ? '' : String(feeParts[part]);
          $(`fee-${part}-auto`).hidden = feeAutoPart !== part;
        });
      }
      function reportFee(message, error = false) {
        const el = $('fee-details-status');
        el.textContent = message;
        el.classList.toggle('error', error);
      }
      function syncOuterFee() {
        $('fee-number').value = String(state.fee);
        setSlider('fee');
      }
      function updateFeeFromParts() {
        if (!feeExpanded) return;
        const manualKeys = feeKeys.filter(k => feeParts[k] !== null && feeAutoPart !== k);
        if (feeAutoPart !== null && manualKeys.length !== 2) {
          feeParts[feeAutoPart] = null;
          feeAutoPart = null;
        }
        if (feeAutoPart !== null) {
          const sum = roundCents(manualKeys.reduce((acc,k) => acc + feeParts[k],0));
          const difference = roundCents(state.fee - sum);
          if (difference < 0) {
            feeParts[feeAutoPart] = null;
            feeAutoPart = null;
            reportFee(`已填細項共 ${sum}% ，大於最外層 ${state.fee}%。請調整金額。暫時仍以最外層抽成計算。`,true);
            showFeeParts();
            return;
          }
          feeParts[feeAutoPart] = difference;
          reportFee(`已自動補齊「${feeLabel(feeAutoPart)}」${difference}%；三項合計 ${state.fee}%。`);
        } else if (manualKeys.length === 2) {
          const missing = feeKeys.find(k => feeParts[k] === null);
          const sum = roundCents(manualKeys.reduce((acc,k) => acc + feeParts[k],0));
          const rest = roundCents(state.fee - sum);
          if (rest < 0) {
            reportFee(`已填兩項合計 ${sum}% ，高於最外層 ${state.fee}%；剩餘項目不能是負數。暫以最外層抽成計算。`,true);
          } else {
            feeAutoPart = missing;
